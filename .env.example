# Copy this file to .env (git-ignored) and fill in the values.
# Never commit .env or paste these values anywhere else.

# Anthropic API key (console.anthropic.com) — drafting posts with Claude
ANTHROPIC_API_KEY=

# Meta system user token (polein-bot, expiration "Never") — publishing
META_ACCESS_TOKEN=
# Found by: node scripts/social/meta-check.js
META_PAGE_ID=
META_IG_USER_ID=
# Optional: Instagram location tag (a Facebook place Page ID). Default: the
# Polein Page (Zapopan). Set to none to post without location.
# META_IG_LOCATION_ID=
